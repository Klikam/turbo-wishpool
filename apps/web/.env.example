# Origin of the NestJS backend (apps/backend), without a trailing slash.
# Used for server-side API calls and to proxy /api/auth/* (better-auth),
# so it is read at build time as well as at runtime.
BACKEND_URL=http://localhost:3001

# Public origin of this site, without a trailing slash, e.g.
# https://wishpool.app. Link previews (WhatsApp, Messenger…), the sitemap
# and robots.txt use it for absolute URLs.
SITE_URL=http://localhost:3000
