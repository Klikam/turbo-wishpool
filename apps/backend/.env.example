PORT=3001
DATABASE_URL=

# better-auth
# Public origin of the web app.
WEB_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Email (verification now, notifications later). Any SMTP provider works, e.g.
# Brevo: smtp-relay.brevo.com, port 587, SMTP login + SMTP key from their dashboard.
# Leave SMTP_HOST empty in development: emails are logged to the console instead.
# MAIL_FROM must be a sender/domain verified with the provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wishpool <no-reply@example.com>"
