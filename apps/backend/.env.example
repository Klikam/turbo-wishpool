PORT=3001
DATABASE_URL=

# Proxies allowed to set X-Forwarded-For, which decides the visitor IP used
# for rate limiting. The web app forwards it on every API call, so the web
# server's address (and any load balancer in front of the backend) must be
# trusted. Express "trust proxy" values: an address/subnet list such as
# "loopback, 10.0.0.0/8" or a hop count such as "1" (the usual choice when
# an edge proxy sits in front of the web server and appends the visitor IP).
# Never "true": visitors could then pick their own IP, and the backend refuses
# to start with it in production. The default only fits a web server on the
# same host; elsewhere all visitors would share one limit (a warning is logged).
# See docs/adr/0003-rate-limit-visitor-ip.md.
TRUST_PROXY=loopback

# better-auth
# Public origin of the web app.
WEB_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Social sign-in. A provider stays disabled while its id or secret is empty.
# Register this redirect URI with each provider (swap in the production WEB_URL):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/facebook
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: developers.facebook.com > Create app > Facebook Login (App ID / App Secret)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email (verification now, notifications later). Any SMTP provider works, e.g.
# Resend: smtp.resend.com, port 587, SMTP_USER=resend, SMTP_PASS=an API key.
# Brevo: smtp-relay.brevo.com, port 587, SMTP login + SMTP key from their dashboard.
# Leave SMTP_HOST empty in development: emails are logged to the console instead.
# MAIL_FROM must be a sender/domain verified with the provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wishpool <no-reply@example.com>"
