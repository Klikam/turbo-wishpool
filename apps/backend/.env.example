PORT=3001
DATABASE_URL=

# better-auth
# Public origin of the web app (OAuth redirect URIs are built from it).
WEB_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Email (verification now, notifications later). Any SMTP provider works, e.g.
# Brevo: smtp-relay.brevo.com, port 587, SMTP login + SMTP key from their dashboard.
# Leave SMTP_HOST empty in development: emails are logged to the console instead.
# MAIL_FROM must be a sender/domain verified with the provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wishpool <no-reply@example.com>"

# Social login. A provider is only enabled when both values are set.
# Redirect URI to register: ${WEB_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register: ${WEB_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
