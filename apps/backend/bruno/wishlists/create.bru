meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/wishlists
  body: json
  auth: inherit
}

body:json {
  {
    "title": "My birthday",
    "occasion": "birthday",
    "date": "2026-12-24",
    "note": "Anything is welcome"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("wishlistId", res.body.id);
  }
}
