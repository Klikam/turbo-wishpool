meta {
  name: update
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/wishlists/{{wishlistId}}
  body: json
  auth: inherit
}

body:json {
  {
    "title": "My updated birthday",
    "occasion": "other",
    "note": "Updated note"
  }
}

docs {
  Send only the fields to change; null clears occasion, date and note. `closed` marks the list as past (true) or reopens it (false).
}
