meta {
  name: delete user
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/delete-user
  body: json
  auth: bearer
}

headers {
  Origin: {{webUrl}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "password": "{{password}}"
  }
}

docs {
  Deletes the account for good, with its wishlists, gifts, reservations and requests. Accounts without a password need a session from the last day instead.
}
