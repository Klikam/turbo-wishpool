meta {
  name: change password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

headers {
  Origin: {{webUrl}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{newPassword}}",
    "revokeOtherSessions": true
  }
}
