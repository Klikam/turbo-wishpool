meta {
  name: login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.backendTokens.accessToken);
    bru.setVar("refreshToken", res.body.backendTokens.refreshToken);
  }
}
