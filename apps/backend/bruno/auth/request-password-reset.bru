meta {
  name: request password reset
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/request-password-reset
  body: json
  auth: none
}

headers {
  Origin: {{webUrl}}
}

body:json {
  {
    "email": "{{email}}",
    "redirectTo": "/reset-password"
  }
}

docs {
  Always answers the same, whether or not the account exists. Only accounts with a password get a link (valid for one hour).
}
