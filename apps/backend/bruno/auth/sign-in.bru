meta {
  name: sign in
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Origin: {{webUrl}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const token = res.getHeader("set-auth-token") || (res.body && res.body.token);
  if (res.status === 200 && token) {
    bru.setEnvVar("accessToken", token);
  }
}

docs {
  Stores the session token as `accessToken`. An unverified account gets a fresh verification email instead of a session.
}
