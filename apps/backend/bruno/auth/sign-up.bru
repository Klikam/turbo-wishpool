meta {
  name: sign up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Origin: {{webUrl}}
}

body:json {
  {
    "name": "{{name}}",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

docs {
  Nobody is signed in until the email is verified: open the link printed in the backend console (or sent by SMTP). Password: 8 to 64 characters. Name: 2 to 100 characters.
}
