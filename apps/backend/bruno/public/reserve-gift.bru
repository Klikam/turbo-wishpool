meta {
  name: reserve gift
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/public/wishlists/{{wishlistId}}/gifts/{{giftId}}/reservation
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Fails with 403 on a past list or for the list's owner, and with 409 when the gift is already reserved.
}
