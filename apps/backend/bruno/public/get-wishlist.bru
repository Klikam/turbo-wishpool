meta {
  name: get wishlist
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/public/wishlists/{{wishlistId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Requires a signed-in user. Gifts are shown from their point of view; the list's owner never sees reservations. `isPast` is true for a list that is closed or whose date has passed; visitors can't change anything on it.
}
